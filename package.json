{
  "name": "@trackcore/sdk",
  "version": "0.5.0",
  "description": "TrackCore Web / JavaScript SDK — a thin, typed HTTP client for the TrackCore nutrition API. Server capabilities only (D-015).",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup --config tsup.esm.config.ts && tsup --config tsup.cjs.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && vitest run --reporter=dot",
    "example": "node examples/quickstart.mjs",
    "codegen:codes": "node scripts/generate-codes.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.18.12",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
